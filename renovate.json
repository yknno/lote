{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update gh-actions-lock pin in verify-lockfile workflow",
      "managerFilePatterns": ["/^\\.github/workflows/verify-lockfile\\.ya?ml$/"],
      "matchStrings": [
        "gh extension install (?<depName>github/gh-actions-lock) --pin (?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
